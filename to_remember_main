#include "garbage_collector/garbage_collector.h"
#include <stdio.h>

int main()
{
	t_gb_collector	*gb_c;

	gb_c = NULL;
	char *s = gb_malloc(800, &gb_c);
	for (size_t i = 0; i < 799; i++)
		s[i] = 'a';
	s[799] = '\0';
	printf("%s\n", s);
	int	*nbr = gb_malloc(40, &gb_c);
	for (size_t i = 0; i < 10; i++)
	{
		nbr[i] = 10 + i;
	}
	for (size_t i = 0; i < 10; i++)
	{
		printf("%d\n", nbr[i]);
	}
	gb_free_node(s, &gb_c);
	printf("%s\n", s);
	clean_gb(&gb_c);
}